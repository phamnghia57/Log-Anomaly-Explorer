# Copy thanh ".env.local" de dev local:
#   cp .env.example .env.local
#
# Dia chi query-api ma frontend nay goi. Rong = mac dinh "http://localhost:9002"
# (xem src/lib/api.ts) - khop voi cong QUERY_API_PORT mac dinh trong
# docker-compose.yml o goc repo.
#
# Khi deploy len Vercel, dat bien nay trong Project Settings > Environment
# Variables thanh URL PUBLIC, HTTPS cua backend that - Vercel phuc vu trang qua
# HTTPS nen trinh duyet se CHAN (Mixed Content) neu backend chi co HTTP thuan.
VITE_API_BASE_URL=http://localhost:9002

# Jaeger UI (xem docker-compose.yml muc "jaeger") - bam vao 1 trace_id tren UI
# se mo thang trang chi tiet trace do tren Jaeger. Rong = an lien ket Jaeger
# (dung khi chua trien khai Jaeger, hoac moi truong khong can xem trace).
VITE_JAEGER_URL=http://localhost:16686
