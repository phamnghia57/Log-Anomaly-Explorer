# Copy thanh ".env.local" de dev local:
#   cp .env.example .env.local
#
# Browser calls the same-origin proxy. Vercel requires an HTTPS API_PROXY_TARGET origin.
# For local HTTP set AUTH_COOKIE_SECURE=false on the backend and allow the Vite origin.
VITE_API_BASE_URL=/api
# Vite proxy target locally; Vercel uses an HTTPS origin at build time.
API_PROXY_TARGET=http://localhost:8002
# Chi cau hinh URL public o VITE_*. JWT_SECRET va ADMIN_SEED_* chi o backend.

# Jaeger UI (xem docker-compose.yml muc "jaeger") - bam vao 1 trace_id tren UI
# se mo thang trang chi tiet trace do tren Jaeger. Rong = an lien ket Jaeger
# (dung khi chua trien khai Jaeger, hoac moi truong khong can xem trace).
VITE_JAEGER_URL=http://localhost:16686

# Duong dan /health cua Ingestion & Demo App qua gateway (HTTPS khi deploy).
# Khi dev truy cap thang Query API :8002, co the thay bang http://localhost:8000/health
# va http://localhost:8001/health neu server cho phep CORS (khuyen dung gateway).
VITE_INGESTION_HEALTH_URL=http://localhost/ingestion/health
VITE_DEMO_HEALTH_URL=http://localhost/demo/health
