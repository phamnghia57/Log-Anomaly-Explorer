# Caddyfile - cong vao duy nhat ra Internet cho Log Anomaly Explorer (Nghia).
#
# PUBLIC_ADDRESS (xem docker-compose.yml + .env.example):
#   - Mac dinh ":80" - chi HTTP thuan (dung khi chua co domain/sslip.io, hoac
#     dev/test cuc bo). KHONG dung duoc cho frontend Vercel: Vercel phuc vu
#     qua HTTPS, trinh duyet se chan Mixed Content neu goi sang backend HTTP
#     thuan.
#   - Dat thanh mot domain hoac host sslip.io (vd. "1-2-3-4.sslip.io" voi
#     1.2.3.4 la IP may chu) de Caddy TU DONG xin & gia han chung chi HTTPS
#     (Let's Encrypt) qua port 80 (ACME HTTP-01 challenge) + 443 - khong can
#     cau hinh gi them.
#
# LUU Y QUAN TRONG: port 80/443 chi co the bi chiem boi MOT tien trinh tai
# mot thoi diem. Neu may chu dang co dich vu khac cung dung 2 port nay, phai
# giai phong truoc khi gateway nay khoi dong duoc - xem web/README.md muc
# "Deploy len Vercel".
#
# GATEWAY_BASIC_AUTH_USER/HASH (xem .env.example): bao ve /jaeger va /demo/*.
# De trong thi 2 route nay tra 401 cho moi nguoi (khoa han, khong mo public);
# cac route khac van chay. /docs /redoc /openapi.json khong con route ra
# ngoai; xem qua SSH tunnel toi cong QUERY_API_PORT tren VM.

{$PUBLIC_ADDRESS} {
	@webHealthOrigin header Origin {$CORS_WEB_ORIGIN:http://localhost:5173}
	# Query API, gom POST/OPTIONS /auth/login; giu nguyen Authorization khi proxy.
	# /assistant* - AI Assistant (GET conversation, POST message), xem
	# query-api/src/assistant/router.py.
	@query path /health /auth/login /auth/refresh /auth/logout /search* /clusters* /clustering/health /assistant*
	handle @query {
		reverse_proxy query-api:8002
	}

	# Chi expose health cua ingestion, khong expose /ingest ra internet.
	@ingestion_health path /ingestion/health
	handle @ingestion_health {
		uri strip_prefix /ingestion
		header +Vary Origin
		header @webHealthOrigin Access-Control-Allow-Origin {$CORS_WEB_ORIGIN:http://localhost:5173}
		reverse_proxy ingestion:8000
	}

	# Health demo co CORS de trang web (Vercel) hien thi trang thai.
	@demo_health path /demo/health
	handle @demo_health {
		uri strip_prefix /demo
		header +Vary Origin
		header @webHealthOrigin Access-Control-Allow-Origin {$CORS_WEB_ORIGIN:http://localhost:5173}
		reverse_proxy demo-app:8001
	}

	# /demo/* -> Demo App (Manh), vd. /demo/simulate-error - tien goi tu xa de
	# tao du lieu demo ma khong can SSH vao VM. Dat sau basic auth: goi duoc
	# route nay la tao duoc cum bat thuong that va email alert that.
	handle_path /demo/* {
		basic_auth {
			{$GATEWAY_BASIC_AUTH_USER} {$GATEWAY_BASIC_AUTH_HASH}
		}
		reverse_proxy demo-app:8001
	}

	# /jaeger/* -> Jaeger UI, de nut "Xem trace tren Jaeger" cua web/ hoat
	# dong duoc tu trang Vercel (HTTPS). Dung "handle" (KHONG phai
	# "handle_path"): Jaeger duoc cau hinh QUERY_BASE_PATH=/jaeger (xem
	# docker-compose.yml) nen tu no can nhan duong dan CON NGUYEN tien to
	# "/jaeger" - cat mat tien to se lam sai route/asset noi bo cua UI do.
	# Trace chua URL/status/trace_id that nen dat sau basic auth.
	@jaeger path /jaeger*
	handle @jaeger {
		basic_auth {
			{$GATEWAY_BASIC_AUTH_USER} {$GATEWAY_BASIC_AUTH_HASH}
		}
		reverse_proxy jaeger:16686
	}

	handle {
		respond "Log Anomaly Explorer - xem /health, /search, /clusters, /clusters/{id}, /assistant/*, /demo/*, /jaeger/*" 200
	}
}
