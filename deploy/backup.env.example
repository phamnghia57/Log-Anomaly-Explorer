# Copy thanh deploy/backup.env tren VM (file nay KHONG commit, da co trong .gitignore).
# deploy/backup.sh tu doc file do neu co.

# Dich rsync ngoai VM (can SSH key khong mat khau tu VM toi dich). De trong =
# chi giu tren VM; khi do keo ve bang deploy/pull-backup.sh tu may thanh vien.
BACKUP_REMOTE=
# BACKUP_SSH_OPTS="-o BatchMode=yes -i /home/azureuser/.ssh/backup_ed25519"

# Healthchecks.io check RIENG cho job backup (period 1 ngay, grace 2 gio).
# Khong dung chung URL voi worker clustering.
BACKUP_PING_URL=

# RETENTION_DAYS=7
# MIN_KEEP=2
