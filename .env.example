# Mau bien moi truong cho docker-compose.yml o goc repo.
# Dung:  cp .env.example .env   roi sua gia tri can doi.
# Cac bien ha tang co mac dinh; auth can JWT_SECRET rieng, khong co fallback.

# --- Cong publish ra may chu -----------------------------------------------
# Doi neu cong mac dinh da bi dich vu khac tren may chiem.
INGESTION_PORT=8000
DEMO_APP_PORT=8001
QUERY_API_PORT=8002
JAEGER_UI_PORT=16686

# --- Gateway (Caddy) ---------------------------------------------------------
# Cong vao HTTPS duy nhat ra Internet, BAT BUOC co de frontend tren Vercel goi
# duoc backend. Luon dung port 80/443 (khong doi duoc - Let's Encrypt yeu cau
# dung 2 port nay de xac thuc domain), xem deploy/Caddyfile va
# web/README.md muc "Deploy len Vercel".
#
# Mac dinh ":80" = HTTP thuan qua IP (CHUA du cho Vercel, Mixed Content se bi
# chan). Dat thanh domain that, hoac host sslip.io (vd. "1-2-3-4.sslip.io" voi
# 1.2.3.4 la IP cong khai cua may chu) de Caddy tu dong xin HTTPS.
PUBLIC_ADDRESS=:80

# --- Tracing (Jaeger) --------------------------------------------------------
# So trace toi da giu trong RAM cua Jaeger (SPAN_STORAGE_TYPE=memory, khong
# persist) - gioi han de tranh phinh RAM tren may chu nho khi demo chay nhieu
# ngay lien tuc.
JAEGER_MAX_TRACES=20000
# Tro demo-app sang mot OTLP endpoint khac (vd. OTel Collector that) thay vi
# Jaeger trong chinh stack nay. Rong = dung mac dinh http://jaeger:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Kho du lieu -----------------------------------------------------------
# Mac dinh dung OpenSearch trong chinh stack nay. Tro sang mot OpenSearch co
# san bang cach doi URL (khi do co the bo service `opensearch` khoi stack).
# OPENSEARCH_URL=http://opensearch:9200
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=

# Ten index. Doi khi dung chung mot OpenSearch voi he thong khac va can tach
# du lieu rieng ra.
LOG_INDEX=logs
QUARANTINE_INDEX=logs-quarantine
CLUSTER_INDEX=clusters
# Luu lich su anomaly score theo thoi gian (1 diem/chu ky/cum, KHONG upsert -
# khac CLUSTER_INDEX o tren). Xem docs/architect/contracts/cluster-history-schema.json.
HISTORY_INDEX=cluster-history
USERS_INDEX=users

# Kich thuoc heap JVM cua OpenSearch. Giam xuong (vd. 256m) khi may chu it RAM.
OPENSEARCH_HEAP=512m

# --- Query API: chuan bi cau hinh auth -------------------------------------
# Bat buoc cung cap secret rieng khi su dung authentication; khong commit secret.
# De trong o file mau. Buoc nay chua them login/route guard hay seed user.
JWT_SECRET=
JWT_EXPIRY_SECONDS=3600
# Chi dung de seed admin lan dau o buoc sau; khong co credentials mac dinh.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# --- Ingestion -------------------------------------------------------------
RETENTION_DAYS=30
RETENTION_INTERVAL_SECONDS=3600

# --- Clustering ------------------------------------------------------------
WINDOW_SECONDS=60
HISTORY_WINDOWS=30
INGESTION_LAG_SECONDS=10
ANOMALY_THRESHOLD=2.0
# Webhook nhan alert khi vuot nguong; de trong = khong gui (van cap nhat status).
ALERT_WEBHOOK_URL=
# Lop TF-IDF augment (xem clustering/README.md). false = chay hoan toan rule-based.
ML_AUGMENT_ENABLED=true
