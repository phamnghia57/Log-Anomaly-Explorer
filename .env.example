# Mau bien moi truong cho docker-compose.yml o goc repo.
# Dung:  cp .env.example .env   roi sua gia tri can doi.
# Cac bien ha tang co mac dinh; auth can JWT_SECRET rieng, khong co fallback.

# --- Cong publish ra may chu -----------------------------------------------
# Doi neu cong mac dinh da bi dich vu khac tren may chiem. Mac dinh trong
# docker-compose.yml la 8000/8001/8002 (dung khi khong co .env, vd. CI); may
# chu deploy hien tai dung 9000/9001/9002 vi day 80xx da bi stack khac chiem.
# Cac cong nay chi bind 127.0.0.1 (khong ra Internet): goi tu chinh may chu
# (curl localhost:9002) hoac qua SSH tunnel. Duong vao public duy nhat la gateway.
INGESTION_PORT=9000
DEMO_APP_PORT=9001
QUERY_API_PORT=9002
JAEGER_UI_PORT=16686

# --- Gateway (Caddy) ---------------------------------------------------------
# Cong vao HTTPS duy nhat ra Internet, BAT BUOC co de frontend tren Vercel goi
# duoc backend. Luon dung port 80/443 (khong doi duoc - Let's Encrypt yeu cau
# dung 2 port nay de xac thuc domain), xem deploy/Caddyfile va
# web/README.md muc "Deploy len Vercel".
#
# Mac dinh ":80" = HTTP thuan qua IP (CHUA du cho Vercel, Mixed Content se bi
# chan). Dat thanh domain that, hoac host sslip.io (vd. "1-2-3-4.sslip.io" voi
# 1.2.3.4 la IP cong khai cua may chu) de Caddy tu dong xin HTTPS.
PUBLIC_ADDRESS=:80
# Basic auth cho /jaeger va /demo/* tren gateway. De trong thi 2 route nay tra
# 401 cho moi nguoi (route khac van chay). Tao hash (khong commit):
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext '<mat-khau>'
# Hash co ky tu "$" -> PHAI boc nhay don, neu khong Compose doc "$2a" thanh bien:
#   GATEWAY_BASIC_AUTH_HASH='$2a$14$...'
GATEWAY_BASIC_AUTH_USER=
GATEWAY_BASIC_AUTH_HASH=

# --- Tracing (Jaeger) --------------------------------------------------------
# Jaeger luu trace tren disk bang Badger trong named volume, khong con dung
# in-memory storage. Retention mac dinh 7 ngay; TTL gioi han tuoi du lieu de
# tranh tich luy vo han, nhung khong phai hard quota cho disk. Can giam sat
# dung luong volume (du lieu het TTL duoc don theo co che maintenance cua Badger).
JAEGER_TRACE_TTL=168h
# Tro demo-app sang mot OTLP endpoint khac (vd. OTel Collector that) thay vi
# Jaeger trong chinh stack nay. Rong = dung mac dinh http://jaeger:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Kho du lieu -----------------------------------------------------------
# Mac dinh dung OpenSearch trong chinh stack nay. Tro sang mot OpenSearch co
# san bang cach doi URL (khi do co the bo service `opensearch` khoi stack).
# OPENSEARCH_URL=http://opensearch:9200
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=

# Ten index. Doi khi dung chung mot OpenSearch voi he thong khac va can tach
# du lieu rieng ra.
LOG_INDEX=logs
QUARANTINE_INDEX=logs-quarantine
CLUSTER_INDEX=clusters
# Luu lich su anomaly score theo thoi gian (1 diem/chu ky/cum, KHONG upsert -
# khac CLUSTER_INDEX o tren). Xem docs/architect/contracts/cluster-history-schema.json.
HISTORY_INDEX=cluster-history
USERS_INDEX=users
# Luu hoi thoai dieu tra voi AI Assistant (1 conversation/cum). Xem
# docs/architect/contracts/assistant-conversation-schema.json.
ASSISTANT_CONVERSATIONS_INDEX=assistant-conversations

# Kich thuoc heap JVM cua OpenSearch. Giam xuong (vd. 256m) khi may chu it RAM.
OPENSEARCH_HEAP=512m

# --- Query API: JWT admin -------------------------------------------------
# Bat buoc cung cap secret ngau nhien >=32 bytes UTF-8 cho JWT; khong commit secret.
# De trong o file mau. Login/query routes can JWT secret; /health public. Seed bang lenh rieng.
JWT_SECRET=
JWT_EXPIRY_SECONDS=900
# Seed admin tuong minh: python -m query-api.src.seed_admin (xem query-api/README.md).
# Khong co credentials mac dinh; chay lai khong doi account da ton tai.
# Sau khi seed, bo ADMIN_SEED_* khoi moi truong runtime va recreate query-api.
# JWT_SECRET phai duoc giu on dinh trong secret store, khong sinh lai moi restart.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# --- Ingestion -------------------------------------------------------------
# Cung dung cho cluster-history: worker don diem cu hon so ngay nay moi gio.
RETENTION_DAYS=30
RETENTION_INTERVAL_SECONDS=3600
# Drop index `logs` monolithic cu khi log moi nhat trong do da qua RETENTION_DAYS (false = giu lai de backup/migrate).
RETENTION_DROP_LEGACY_INDEX=true
# Xoa ban ghi QUARANTINE_INDEX (log sai schema) co received_at cu hon so ngay nay
# (delete_by_query, cung chu ky RETENTION_INTERVAL_SECONDS). Index nay khong nam
# trong snapshot backup, nen day la tran dia duy nhat cua no. >= 1.
QUARANTINE_RETENTION_DAYS=30
# Rate limit ingest (RPS/process) va so log toi da moi batch.
INGEST_RATE_LIMIT_RPS=100
INGEST_MAX_BATCH_SIZE=500

# --- Clustering ------------------------------------------------------------
WINDOW_SECONDS=60
HISTORY_WINDOWS=30
INGESTION_LAG_SECONDS=10
# Dung cho CA `clustering` (nguong that de gui alert) va `query-api` (de AI
# Assistant noi dung nguong dang ap dung). Doi thi recreate ca hai service.
ANOMALY_THRESHOLD=3.0
# Webhook nhan alert khi vuot nguong; de trong = khong gui (van cap nhat status).
ALERT_WEBHOOK_URL=
# Public web URL used to build links to incident details in alerts.
ALERT_WEB_BASE_URL=
# Ping URL cua dich vu uptime ngoai (Healthchecks.io) cho dead-man switch:
# worker ping sau moi chu ky thanh cong, dich vu gui email neu ping tat han -
# phat hien duoc ca truong hop ca VM chet, khac voi ALERT_WEBHOOK_URL (chi gui
# khi CO bat thuong). De trong = tat. URL la secret, khong commit URL that.
HEALTHCHECK_PING_URL=
# Cooldown per cluster, persisted in <CLUSTER_INDEX>-alert-state by the worker.
ALERT_COOLDOWN_SECONDS=600
# Lop TF-IDF augment (xem clustering/README.md). false = chay hoan toan rule-based.
ML_AUGMENT_ENABLED=true
ML_SIMILARITY_THRESHOLD=0.9

# --- AI Assistant (query-api/src/assistant/) --------------------------------
# Dieu tra & de xuat cach sua loi, giong Elastic Observability AI Assistant
# (xem query-api/README.md muc "AI Assistant"). BAT BUOC tu dien gia tri that
# vao .env (khong commit) - de trong o file mau nay, assistant tra 503 neu
# thieu, KHONG anh huong cac endpoint khac cua query-api.
#
# Dung AZURE OpenAI (khong dung OpenAI truc tiep): VM dang chay o vung Azure
# "East Asia" (Hong Kong), bi OpenAI chan request theo IP
# (unsupported_country_region_territory). Tao resource Azure OpenAI o VUNG
# KHAC (vd. UAE North/East US - KHONG chon East Asia), deploy model
# gpt-5-mini (tang "mini", can bang hieu nang/chi phi cho tool-calling),
# lay 2 gia tri duoi tu "Keys and Endpoint" + ten deployment. Goi qua
# "<endpoint>/openai/v1/" (xem assistant/config.py::azure_openai_v1_base_url) -
# KHONG dung api-version co dinh, theo dung huong dan hien tai cua Microsoft
# cho model dong reasoning (mot api-version cu se khien reasoning_effort va
# cac tham so moi khac bi am tham bo qua).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# Gioi han thoi gian cho MOI lan goi Azure OpenAI (giay) - model dong reasoning
# co the suy luan rat lau, can chan de khong treo request vo thoi han.
AZURE_OPENAI_TIMEOUT_SECONDS=60
# Muc do "suy nghi" cua model dong reasoning (minimal/low/medium/high). "low"
# uu tien toc do, chat luong trung binh la du cho du lieu log demo tu sinh.
ASSISTANT_REASONING_EFFORT=low
# Gioi han so vong AI tu goi tool trong 1 luot chat - bao ve chi phi/do tre. De
# thap vi log cua du an nay la du lieu tu sinh/mo phong, AI chi can neu nguyen
# nhan co ban, khong can dieu tra nhieu vong.
ASSISTANT_MAX_TOOL_ROUNDS=2
ASSISTANT_MAX_OUTPUT_TOKENS=1200
# Jaeger query API noi bo cho tool get_trace cua AI Assistant. De TRONG = tat
# tool do. Phai kem base path neu Jaeger chay duoi tien to (QUERY_BASE_PATH
# trong docker-compose.yml), vi base path ap cho ca API lan UI:
#   JAEGER_QUERY_URL=http://jaeger:16686/jaeger
JAEGER_QUERY_URL=
JAEGER_TIMEOUT_SECONDS=5
# So message CU nhieu nhat gui lai lam ngu canh moi luot hoi. Hoi thoai van
# LUU day du, gioi han nay chi chan chi phi token tang dan theo do dai hoi
# thoai (moi luot deu gui lai toan bo lich su).
ASSISTANT_MAX_HISTORY_MESSAGES=20
# Retention cho index hoi thoai (xem query-api/src/assistant/retention.py):
# xoa hoi thoai khong duoc hoi tiep trong bao nhieu ngay, va chu ky chay job
# nen (giay). INTERVAL=0 -> tat job nen, chay bang cron ben ngoai:
#   python -m query-api.src.assistant.retention
ASSISTANT_RETENTION_DAYS=30
ASSISTANT_RETENTION_INTERVAL_SECONDS=86400

# Theo doi chi phi/do tre/token qua Langfuse (https://jp.cloud.langfuse.com).
# De trong ca 2 key = assistant van chay, chi khong co trace gui di.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# Persistent auth sessions. For local HTTP only set AUTH_COOKIE_SECURE=false.
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_SESSIONS_INDEX=auth-sessions
AUTH_LOGIN_LIMIT_INDEX=auth-login-limits
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=300
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_WEB_ORIGIN=http://localhost:5173
